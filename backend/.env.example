APP_NAME="Spoken English Agent"
# Use anonymous only when Azure platform authentication protects the hosted API.
FUNCTIONS_HTTP_AUTH_LEVEL="function"
# Local SQLite stores session metadata, learner recordings, and transcripts.
DATABASE_PATH="./data/spoken_agents.sqlite3"
# Hosted private app: azureblob://spoken-sessions/sessions.sqlite3
# Uses AzureWebJobsStorage by default; optionally use a separate storage account.
DATABASE_BLOB_CONNECTION_STRING=""
# Optional PostgreSQL connection URI. Set as a secret in the deployment environment.
DATABASE_URL=""
# Optional process environment setting. Size this against the total worker count.
POSTGRES_POOL_MAX_SIZE="2"
# Temporarily reject learner requests and pause writes from the hosted timer during cutover.
DATABASE_MAINTENANCE="false"
# Optional, private, dedicated container for this database's learner recordings.
# Blank container keeps new recordings in SQLite. Uses AzureWebJobsStorage by default.
RECORDINGS_BLOB_CONTAINER=""
RECORDINGS_BLOB_CONNECTION_STRING=""
# Per-account quotas shared through the configured database; tune before public use.
ACCOUNT_REQUESTS_PER_MINUTE=120
ACCOUNT_SESSIONS_PER_HOUR=20
ACCOUNT_EVALUATIONS_PER_HOUR=20
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com"
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT="gpt-realtime-2.1"
REALTIME_VOICE="verse"
# Separate text model deployment supporting strict structured outputs.
AZURE_OPENAI_EVALUATION_DEPLOYMENT=""
# Set no higher than the actual text model context. Admission uses a conservative
# UTF-8 byte upper bound for byte-level models, plus framing/output/safety reserves.
EVALUATION_CONTEXT_CAPACITY=32768

# Azure Speech resource credentials (separate from Azure OpenAI).
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
# Optional: local defaults to sdk; Azure Functions defaults to rest.
SPEECH_ASSESSMENT_TRANSPORT=""
